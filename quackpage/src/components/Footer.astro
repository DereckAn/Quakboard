---
import Icon from "./Icon.astro";

const cols = [
  {
    title: "Product",
    links: [
      { href: "/", label: "Overview" },
      { href: "/download", label: "Download" },
      { href: "/changelog", label: "Changelog" },
    ],
  },
  {
    title: "Docs",
    links: [
      { href: "/docs/getting-started", label: "Getting Started" },
      { href: "/docs/keyboard-shortcuts", label: "Keyboard Shortcuts" },
      { href: "/docs/sync", label: "Sync" },
      { href: "/docs/privacy", label: "Privacy & Data" },
    ],
  },
  {
    title: "Company",
    links: [
      { href: "/privacy", label: "Privacy Promise" },
      { href: "/docs/getting-started", label: "Support" },
    ],
  },
];
---

<footer class="mt-32 border-t border-border-soft">
  <div class="shell py-14">
    <div class="grid gap-12 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <div>
        <a href="/" class="flex items-center gap-2.5">
          <span
            class="grid h-7 w-7 place-items-center rounded-md bg-accent text-accent-ink"
          >
            <Icon name="clipboard" size={16} stroke={2} />
          </span>
          <span class="font-heading text-lg font-semibold">Quakboard</span>
        </a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-muted">
          A clipboard manager that keeps your history close and your data
          yours. Local-first, fast, and quiet.
        </p>
      </div>

      {
        cols.map((col) => (
          <div>
            <h3 class="text-xs font-semibold uppercase tracking-wider text-faint">
              {col.title}
            </h3>
            <ul class="mt-4 space-y-2.5 text-sm">
              {col.links.map((l) => (
                <li>
                  <a
                    href={l.href}
                    class="text-muted transition-colors hover:text-text"
                  >
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div
      class="mt-12 flex flex-col items-start justify-between gap-4 border-t border-border-soft pt-8 text-sm text-faint sm:flex-row sm:items-center"
    >
      <p>© 2026 Quakboard. Built local-first.</p>
      <p class="font-mono text-xs">v1.1.0 — macOS · Windows · Linux</p>
    </div>
  </div>
</footer>
