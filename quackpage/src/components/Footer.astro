---
import { url } from "../url";
import { ISSUES_URL, RELEASES_URL } from "../releases";

const cols = [
  {
    title: "Product",
    links: [
      { href: "/", label: "Overview" },
      { href: "/download", label: "Download" },
      { href: "/sync", label: "How sync works" },
      { href: RELEASES_URL, label: "Release notes" },
    ],
  },
  {
    title: "Help",
    links: [
      { href: "/support", label: "Support" },
      { href: ISSUES_URL, label: "Report a problem" },
      { href: "https://github.com/DereckAn/Quakboard", label: "Source code" },
    ],
  },
  {
    title: "Legal",
    links: [{ href: "/privacy", label: "Privacy policy" }],
  },
];
---

<footer class="mt-32 border-t border-border-soft">
  <div class="shell py-14">
    <div class="grid gap-12 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <div>
        <a href={url("/")} class="flex items-center gap-2.5">
          <img src={url("/logo.png")} alt="" width="40" height="40" class="h-10 w-10" />
          <span class="font-heading text-lg font-semibold">Quakboard</span>
        </a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-muted">
          A clipboard manager that keeps your history close and your data
          yours. Local-first, fast, and quiet.
        </p>
      </div>

      {
        cols.map((col) => (
          <div>
            <h3 class="text-xs font-semibold uppercase tracking-wider text-faint">
              {col.title}
            </h3>
            <ul class="mt-4 space-y-2.5 text-sm">
              {col.links.map((l) => (
                <li>
                  <a
                    href={l.href.startsWith("/") ? url(l.href) : l.href}
                    class="text-muted transition-colors hover:text-text"
                  >
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div
      class="mt-12 flex flex-col items-start justify-between gap-4 border-t border-border-soft pt-8 text-sm text-faint sm:flex-row sm:items-center"
    >
      <p>© 2026 Quakboard. Built local-first.</p>
      <p class="font-mono text-xs">macOS · Windows · Linux · iPhone &amp; iPad</p>
    </div>
  </div>
</footer>
