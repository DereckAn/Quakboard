---
import { url } from "../url";
import Icon from "./Icon.astro";

const links = [
  { href: "/", label: "Home" },
  { href: "/download", label: "Download" },
  { href: "/sync", label: "How sync works" },
  { href: "/support", label: "Support" },
  { href: "/privacy", label: "Privacy" },
];

// drop the base path, and the "/" built pages end in (/Quakboard/download/)
const path =
  Astro.url.pathname.slice(url("").length).replace(/(.)\/$/, "$1") || "/";
const isActive = (l: { href: string }) => path === l.href;
---

<header
  class="sticky top-0 z-50 border-b border-border-soft bg-bg/80 backdrop-blur-sm"
>
  <nav class="shell flex h-16 items-center justify-between gap-6">
    <a href={url("/")} class="flex items-center gap-2.5" aria-label="Quakboard home">
      <img src={url("/logo.png")} alt="" width="40" height="40" class="h-10 w-10" />
      <span class="font-heading text-lg font-semibold tracking-tight"
        >Quakboard</span
      >
    </a>

    <ul class="hidden items-center gap-1 md:flex">
      {
        links.map((l) => (
          <li>
            <a
              href={url(l.href)}
              aria-current={isActive(l) ? "page" : undefined}
              class={`relative rounded-md px-3 py-2 text-sm transition-colors hover:text-text ${
                isActive(l) ? "text-text" : "text-muted"
              }`}
            >
              {l.label}
              {isActive(l) && (
                <span class="absolute inset-x-0 bottom-0.5 mx-auto h-px w-4 bg-accent" />
              )}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-3">
      <a
        href={url("/download")}
        class="inline-flex items-center gap-2 rounded-md bg-accent px-3.5 py-2 text-sm font-medium text-accent-ink transition-colors hover:bg-accent-strong"
      >
        <Icon name="download" size={16} stroke={2} />
        <span class="hidden sm:inline">Download</span>
      </a>
    </div>
  </nav>

  <!-- mobile nav -->
  <div class="border-t border-border-soft md:hidden">
    <ul class="shell flex items-center gap-1 overflow-x-auto py-2 text-sm">
      {
        links.map((l) => (
          <li>
            <a
              href={url(l.href)}
              aria-current={isActive(l) ? "page" : undefined}
              class={`whitespace-nowrap rounded-md px-3 py-1.5 transition-colors ${
                isActive(l) ? "bg-surface text-text" : "text-muted"
              }`}
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>
