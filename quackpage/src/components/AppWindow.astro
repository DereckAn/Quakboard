---
import Icon from "./Icon.astro";

/**
 * The desktop app drawn in HTML, in the draft's two-pane layout: history on
 * the left, the open clip on the right. Every detail is a real feature.
 * NOTE: swap for real screenshots of the desktop, iPhone and iPad once taken.
 */
const clips = [
  { icon: "filter", label: "Color", time: "Just now", body: "#DDD2BD", swatch: "#DDD2BD", open: true },
  { icon: "code", label: "Rust", time: "2m ago", body: "let peers = service.peers().await?;" },
  { icon: "link", label: "Link", time: "14m ago", body: "github.com/DereckAn/Quakboard" },
  { icon: "device", label: "File · On iPhone", time: "1h ago", body: "trip-receipts.pdf · 2.4 MB", fetch: true },
];

const formats = [
  ["HEX", "#DDD2BD"],
  ["RGB", "rgb(221, 210, 189)"],
  ["HSL", "hsl(39, 32%, 80%)"],
  ["OKLCH", "oklch(0.87 0.031 84)"],
];

const facts = [
  ["Pairing", "6-digit code", "SPAKE2, never sent"],
  ["Encryption", "ChaCha20", "Poly1305, end to end"],
  ["Network", "Local only", "No server, no account"],
];
---

<div class="rounded-xl bg-surface-2 p-3 shadow-xl sm:p-5">
  <div class="flex items-center justify-between px-2 pb-3">
    <div class="flex items-center gap-2" aria-hidden="true">
      <span class="h-3 w-3 rounded-full bg-faint/40"></span>
      <span class="h-3 w-3 rounded-full bg-faint/40"></span>
      <span class="h-3 w-3 rounded-full bg-faint/40"></span>
      <span class="ml-2 font-mono text-[10px] uppercase tracking-widest text-faint">Quakboard</span>
    </div>
    <span class="hidden items-center gap-1.5 rounded-full bg-surface px-2.5 py-1 font-mono text-[10px] text-muted sm:flex">
      <Icon name="sync" size={12} /> Synced with 2 devices
    </span>
  </div>

  <div class="grid gap-4 rounded-lg bg-bg p-4 shadow-inner sm:p-5 lg:grid-cols-12">
    <div class="flex flex-col gap-3 lg:col-span-5">
      <div class="flex items-center gap-2 rounded-lg bg-surface px-3 py-2 text-sm text-faint">
        <Icon name="search" size={15} /> Search clipboard…
      </div>
      <p class="font-mono text-[10px] uppercase tracking-widest text-faint">Today</p>
      {
        clips.map((c) => (
          <div class={`rounded-lg p-3 ${c.open ? "bg-surface shadow-sm ring-1 ring-accent/30" : "bg-surface/60"}`}>
            <div class="flex items-center justify-between font-mono text-[10px] text-faint">
              <span class="flex items-center gap-1.5 uppercase tracking-wide">
                <Icon name={c.icon} size={12} /> {c.label}
              </span>
              <span>{c.time}</span>
            </div>
            <p class="mt-1.5 flex items-center gap-2 truncate font-mono text-[12px] text-text">
              {c.swatch && <span class="h-3 w-3 shrink-0 rounded-sm" style={`background:${c.swatch}`} />}
              <span class="truncate">{c.body}</span>
              {c.fetch && (
                <span class="ml-auto shrink-0 rounded bg-accent px-2 py-0.5 text-[10px] font-semibold text-accent-ink">Fetch</span>
              )}
            </p>
          </div>
        ))
      }
    </div>

    <div class="flex flex-col gap-4 lg:col-span-7">
      <div class="flex items-center justify-between">
        <span class="font-semibold text-text">Color</span>
        <span class="rounded bg-surface px-2 py-0.5 font-mono text-[10px] text-muted">Copied just now</span>
      </div>
      <div class="h-24 rounded-lg" style="background:#DDD2BD"></div>
      <div class="rounded-lg bg-code-bg p-4 font-mono text-[12px] text-code-text">
        {
          formats.map(([k, v]) => (
            <div class="flex justify-between gap-4 py-1">
              <span class="opacity-60">{k}</span>
              <span class="truncate">{v}</span>
            </div>
          ))
        }
      </div>
      <div class="grid grid-cols-3 gap-2">
        {
          facts.map(([k, v, note]) => (
            <div class="flex flex-col rounded-lg bg-surface p-3">
              <span class="font-mono text-[9px] uppercase tracking-wider text-faint">{k}</span>
              <span class="mt-0.5 text-sm font-bold text-text sm:text-base">{v}</span>
              <span class="text-[10px] text-muted">{note}</span>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</div>
