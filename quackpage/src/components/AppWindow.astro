---
import Icon from "./Icon.astro";

/**
 * Signature visual: a realistic Quakboard window rendered entirely in
 * CSS/SVG (no image). Shows a real clipboard-history stack with sample
 * entries so it reads as the actual product.
 */
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;

// Sample clipboard entries — deliberately concrete, not placeholders.
const entries = [
  {
    type: "link",
    icon: "link",
    label: "Link",
    time: "now",
    body: "https://v2.tauri.app/start/migrate/",
    mono: true,
    pinned: false,
  },
  {
    type: "code",
    icon: "code",
    label: "TypeScript",
    time: "2m",
    body: "const items = $derived.by(() => list.filter(i => i.pinned))",
    mono: true,
    pinned: false,
  },
  {
    type: "snippet",
    icon: "pin",
    label: "Snippet · Work address",
    time: "pinned",
    body: "548 Market St, PMB 72018, San Francisco, CA 94104",
    mono: false,
    pinned: true,
  },
  {
    type: "color",
    icon: "filter",
    label: "Color",
    time: "12m",
    body: "#F5A623",
    mono: true,
    pinned: false,
    swatch: "#F5A623",
  },
  {
    type: "text",
    icon: "clipboard",
    label: "Text",
    time: "1h",
    body: "Refund processed — confirmation QB-4471-AX",
    mono: false,
    pinned: false,
  },
];
---

<div
  class={`relative overflow-hidden rounded-xl border border-border bg-surface shadow-2xl shadow-black/60 ${className}`}
>
  <!-- title bar -->
  <div
    class="flex items-center gap-2 border-b border-border-soft bg-surface-2/60 px-4 py-3"
  >
    <span class="flex gap-1.5" aria-hidden="true">
      <span class="h-3 w-3 rounded-full bg-[#3a3a44]"></span>
      <span class="h-3 w-3 rounded-full bg-[#3a3a44]"></span>
      <span class="h-3 w-3 rounded-full bg-[#3a3a44]"></span>
    </span>
    <div class="ml-3 flex flex-1 items-center gap-2 text-xs text-faint">
      <Icon name="clipboard" size={13} />
      <span class="font-mono">Quakboard</span>
    </div>
    <span
      class="rounded border border-border px-1.5 py-0.5 font-mono text-[10px] text-faint"
      >⌘⇧V</span
    >
  </div>

  <!-- search row -->
  <div class="border-b border-border-soft px-4 py-3">
    <div
      class="flex items-center gap-2 rounded-lg border border-border bg-bg px-3 py-2"
    >
      <Icon name="search" size={15} class="text-faint" />
      <span class="font-mono text-sm text-muted">market st</span>
      <span class="ml-auto text-[11px] text-faint">5 results</span>
    </div>
  </div>

  <!-- history stack -->
  <ul class="divide-y divide-border-soft">
    {
      entries.map((e) => (
        <li
          class={`group flex items-start gap-3 px-4 py-3.5 transition-colors hover:bg-surface-2 ${
            e.pinned ? "bg-accent/[0.04]" : ""
          }`}
        >
          <span
            class={`mt-0.5 grid h-7 w-7 shrink-0 place-items-center rounded-md border ${
              e.pinned
                ? "border-accent/30 bg-accent/10 text-accent"
                : "border-border bg-bg text-muted"
            }`}
          >
            <Icon name={e.icon} size={15} />
          </span>

          <div class="min-w-0 flex-1">
            <div class="flex items-center gap-2">
              <span
                class={`text-[11px] font-medium uppercase tracking-wide ${
                  e.pinned ? "text-accent" : "text-faint"
                }`}
              >
                {e.label}
              </span>
              <span class="ml-auto font-mono text-[10px] text-faint">
                {e.time}
              </span>
            </div>
            <p
              class={`mt-1 truncate text-sm ${
                e.mono ? "font-mono text-[13px]" : ""
              } ${e.pinned ? "text-text" : "text-muted"}`}
            >
              {e.swatch && (
                <span
                  class="mr-1.5 inline-block h-3 w-3 translate-y-0.5 rounded-sm border border-white/10"
                  style={`background:${e.swatch}`}
                />
              )}
              {e.body}
            </p>
          </div>
        </li>
      ))
    }
  </ul>

  <!-- footer status -->
  <div
    class="flex items-center justify-between border-t border-border-soft bg-surface-2/40 px-4 py-2.5 text-[11px] text-faint"
  >
    <span class="flex items-center gap-1.5">
      <Icon name="history" size={12} /> 1,284 items
    </span>
    <span class="flex items-center gap-1.5 text-accent">
      <Icon name="lock" size={12} /> Local · encrypted
    </span>
  </div>
</div>
