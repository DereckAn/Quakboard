---
import DocsLayout from "../../layouts/DocsLayout.astro";

const groups = [
  {
    title: "Global",
    note: "Work from any app, even when Quakboard is hidden.",
    rows: [
      [["⌘", "⇧", "V"], "Open history at the cursor"],
      [["⌘", "⇧", "S"], "Open the snippets list"],
      [["⌘", "⇧", "C"], "Copy the last item again"],
    ],
  },
  {
    title: "Inside the window",
    note: "Once the history list is open.",
    rows: [
      [["↑", "↓"], "Move the selection"],
      [["Enter"], "Paste the selected item"],
      [["⌘", "Enter"], "Copy without pasting"],
      [["Esc"], "Close and return to your app"],
      [["⌘", "P"], "Pin / unpin the selected item"],
      [["⌘", "⌫"], "Delete the selected item"],
    ],
  },
  {
    title: "Search",
    note: "The search field is focused the moment the window opens.",
    rows: [
      [["type"], "Filter instantly — no Enter needed"],
      [["type:code"], "Limit results to a content type"],
      [['"exact phrase"'], "Match a full phrase"],
      [["⌘", "K"], "Clear the search field"],
    ],
  },
];
---

<DocsLayout
  title="Keyboard Shortcuts — Quakboard Docs"
  heading="Keyboard Shortcuts"
  summary="Quakboard is built to be driven entirely from the keyboard. Here's every binding. macOS keys shown; on Windows and Linux, ⌘ becomes Ctrl."
>
  <p>
    All global shortcuts can be rebound under <code>Settings → Shortcuts</code> —
    changes take effect immediately, no restart. The defaults below avoid
    clashing with common system bindings.
  </p>

  {
    groups.map((g) => (
      <section class="not-prose mt-10">
        <h2 class="font-heading text-2xl font-bold text-text">{g.title}</h2>
        <p class="mt-1 text-sm text-faint">{g.note}</p>
        <div class="mt-4 overflow-hidden rounded-xl border border-border">
          {g.rows.map(([keys, desc], i) => (
            <div
              class={`flex items-center gap-4 px-4 py-3 ${
                i % 2 === 0 ? "bg-surface" : "bg-surface/40"
              }`}
            >
              <div class="flex w-44 shrink-0 flex-wrap items-center gap-1">
                {(keys as string[]).map((k) => (
                  <kbd class="rounded-md border border-border bg-bg px-2 py-1 font-mono text-xs text-text">
                    {k}
                  </kbd>
                ))}
              </div>
              <span class="text-sm text-muted">{desc}</span>
            </div>
          ))}
        </div>
      </section>
    ))
  }

  <h2>Conflicts with other apps</h2>
  <p>
    If a global shortcut is already claimed by another tool, Quakboard tells you
    on launch instead of silently failing. Pick a free combination in settings,
    or quit the app holding the binding. A common alternative for the history
    shortcut is <code>⌥ Space</code>.
  </p>
</DocsLayout>
