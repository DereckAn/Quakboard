---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";

type Tag = "added" | "improved" | "fixed";

interface Release {
  version: string;
  date: string;
  highlight?: string;
  changes: { tag: Tag; text: string }[];
}

// Newest first.
const releases: Release[] = [
  {
    version: "1.1.0",
    date: "June 18, 2026",
    highlight:
      "End-to-end encrypted sync arrives, plus full-text search and advanced retention controls.",
    changes: [
      { tag: "added", text: "End-to-end encrypted sync across macOS, Windows, and Linux." },
      { tag: "added", text: "Full-text search (SQLite FTS5) with ranked results and phrase matching." },
      { tag: "added", text: "Search result highlighting in the history list." },
      { tag: "added", text: "Retention policies — cap by item count or auto-delete by age." },
      { tag: "added", text: "Database stats and a one-click optimize in Settings." },
      { tag: "improved", text: "Borderless window with rounded corners on every platform." },
      { tag: "fixed", text: "Search field no longer dropped keystrokes during fast typing." },
    ],
  },
  {
    version: "1.0.2",
    date: "May 2, 2026",
    changes: [
      { tag: "fixed", text: "AppImage no longer crashes on Wayland with WebKit/EGL." },
      { tag: "fixed", text: "Global hotkey re-registers correctly after waking from sleep." },
      { tag: "improved", text: "Native Hyprland hotkey support on Linux." },
    ],
  },
  {
    version: "1.0.0",
    date: "April 9, 2026",
    highlight: "The first stable release.",
    changes: [
      { tag: "added", text: "Automatic clipboard capture with smart type detection." },
      { tag: "added", text: "Pinned snippets with custom names." },
      { tag: "added", text: "Server-side pagination with infinite scroll." },
      { tag: "added", text: "Rebindable global shortcuts, no restart required." },
      { tag: "added", text: "Date-grouped history (Today, Yesterday, This Week…)." },
      { tag: "added", text: "Hide from Dock and auto-hide on focus loss (macOS)." },
    ],
  },
  {
    version: "0.9.0",
    date: "March 14, 2026",
    highlight: "Public beta.",
    changes: [
      { tag: "added", text: "Color detection with HEX / RGB / HSL / OKLCH conversion." },
      { tag: "added", text: "Link previews with fetched page titles." },
      { tag: "improved", text: "Capture polling tuned to 500 ms for lower idle CPU." },
    ],
  },
];

const tagStyles: Record<Tag, string> = {
  added: "border-accent/40 bg-accent/10 text-accent",
  improved: "border-border bg-surface-2 text-muted",
  fixed: "border-border bg-surface-2 text-faint",
};
---

<BaseLayout title="Changelog — Quakboard">
  <section class="shell pt-20 pb-12 md:pt-24">
    <div class="max-w-2xl" data-reveal>
      <p class="font-mono text-xs uppercase tracking-widest text-accent">
        Changelog
      </p>
      <h1 class="mt-4 text-5xl font-bold md:text-6xl">What's changed</h1>
      <p class="mt-6 text-lg text-muted">
        Every release, newest first. Quakboard ships small, frequent updates —
        you'll be prompted in-app when one is ready.
      </p>
    </div>
  </section>

  <section class="shell pb-8">
    <div class="space-y-16">
      {
        releases.map((r) => (
          <article
            class="grid gap-6 border-t border-border-soft pt-10 md:grid-cols-[180px_1fr]"
            data-reveal
          >
            <!-- meta column -->
            <div class="md:sticky md:top-24 md:self-start">
              <div class="flex items-center gap-2">
                <span class="font-mono text-sm font-medium text-accent">
                  v{r.version}
                </span>
              </div>
              <time class="mt-1 block text-sm text-faint">{r.date}</time>
            </div>

            <!-- changes column -->
            <div>
              {r.highlight && (
                <p class="mb-5 text-lg leading-relaxed text-text">
                  {r.highlight}
                </p>
              )}
              <ul class="space-y-3">
                {r.changes.map((c) => (
                  <li class="flex items-start gap-3">
                    <span
                      class={`mt-0.5 inline-block w-[68px] shrink-0 rounded-md border px-2 py-0.5 text-center font-mono text-[10px] uppercase tracking-wide ${tagStyles[c.tag]}`}
                    >
                      {c.tag}
                    </span>
                    <span class="text-sm leading-relaxed text-muted">
                      {c.text}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="shell pt-10">
    <div
      class="flex flex-col items-start justify-between gap-4 rounded-xl border border-border bg-surface p-7 sm:flex-row sm:items-center"
      data-reveal
    >
      <div>
        <h2 class="text-lg font-semibold">On the latest version?</h2>
        <p class="mt-1 text-sm text-muted">
          v1.1.0 is the current release. Grab it for your platform.
        </p>
      </div>
      <a
        href="/download"
        class="inline-flex shrink-0 items-center gap-2 rounded-lg bg-accent px-5 py-2.5 text-sm font-semibold text-accent-ink transition-colors hover:bg-accent-strong"
      >
        <Icon name="download" size={17} stroke={2} />
        Download
      </a>
    </div>
  </section>
</BaseLayout>
