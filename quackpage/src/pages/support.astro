---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { ISSUES_URL } from "../releases";

// Answers are HTML so they can link to the other pages.
const faq = [
  {
    q: "My devices don't find each other",
    a: `Both need Quakboard open with sync turned on, on the same Wi-Fi or wired network. If they still don't appear, use <strong>Connect by IP</strong>, and check that your firewall allows Quakboard. <a href="/sync#network">If your devices don't find each other</a> has the steps.`,
  },
  {
    q: "My iPhone or iPad stopped receiving",
    a: "iOS pauses apps in the background, so the phone receives while Quakboard is open and for about 25 seconds after you switch away. Open Quakboard and it reconnects right away.",
  },
  {
    q: "The keyboard shortcut doesn't open Quakboard",
    a: "Another app may already use the same shortcut. Pick a different one in <strong>Settings → Hotkeys</strong>; it works right away, without restarting.",
  },
  {
    q: "macOS says Quakboard is damaged, or Windows won't open it",
    a: `Quakboard isn't signed by Apple or Microsoft yet, so each system asks once. <a href="/download">The Download page</a> shows what to do under <strong>If your system warns you</strong>.`,
  },
  {
    q: "A device shows “Update Quakboard”",
    a: `One of the two devices has a version too old to sync with the other. Update it from <a href="/download">Download</a>, or from the App Store once the phone apps are there.`,
  },
  {
    q: "Does Quakboard save passwords I copy?",
    a: "Yes, it saves everything you copy, and it stays on your devices. Delete an item from history whenever you like.",
  },
  {
    q: "How do I update?",
    a: `On macOS and Windows, Quakboard offers new versions itself. On Linux, download the new version from <a href="/download">Download</a>.`,
  },
  {
    q: "How do I delete all my data?",
    a: `Uninstall Quakboard and delete its folder; <a href="/privacy">the privacy policy</a> lists where it is on each system. On iPhone and iPad, deleting the app removes everything except files you fetched into the Files app.`,
  },
  {
    q: "Is Quakboard free?",
    a: `Yes. It's free and open source under the MIT license, with no account and no ads. The code is on <a href="https://github.com/DereckAn/Quakboard">GitHub</a>.`,
  },
];
---

<BaseLayout title="Support · Quakboard" description="Help with Quakboard: answers to common questions, and how to report a problem.">
  <section class="shell pt-14 pb-12 text-center md:pt-20">
    <div class="mx-auto max-w-2xl" data-reveal>
      <p class="font-mono text-xs uppercase tracking-widest text-muted">Support</p>
      <h1 class="mt-2 text-4xl font-bold text-accent md:text-5xl">How can we help?</h1>
      <p class="mt-4 text-lg text-muted">
        Most questions are answered below. If yours isn't, open an issue on
        GitHub and we'll take a look.
      </p>
    </div>
  </section>

  <section class="shell grid max-w-5xl gap-8 lg:grid-cols-[1fr_18rem]">
    <div class="flex flex-col gap-3">
      {
        faq.map((f) => (
          <details class="group rounded-xl bg-surface shadow-sm" data-reveal>
            <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 px-6 py-4 font-semibold text-accent [&::-webkit-details-marker]:hidden">
              {f.q}
              <span class="shrink-0 text-faint transition-transform group-open:rotate-90">
                <Icon name="arrow-right" size={18} />
              </span>
            </summary>
            <p class="answer px-6 pb-5 text-sm text-muted" set:html={f.a} />
          </details>
        ))
      }
    </div>

    <aside class="flex flex-col gap-5 self-start lg:sticky lg:top-24" data-reveal>
      <div class="rounded-xl bg-accent p-6 text-accent-ink shadow-md">
        <Icon name="code" size={22} />
        <h2 class="mt-3 text-lg font-semibold">Report a problem</h2>
        <p class="mt-1.5 text-sm opacity-85">
          Say which system and Quakboard version you use, what you did, and
          what happened. Leave out anything private you copied.
        </p>
        <a
          href={ISSUES_URL}
          class="mt-5 flex min-h-11 items-center justify-center gap-1.5 rounded-lg bg-bg px-4 py-2 text-sm font-semibold text-accent transition-colors hover:bg-surface"
        >
          Open an issue on GitHub <Icon name="arrow-right" size={15} />
        </a>
      </div>
      <div class="rounded-xl bg-surface-2 p-6">
        <h2 class="font-semibold text-accent">Also helpful</h2>
        <ul class="mt-3 flex flex-col gap-2 text-sm">
          <li><a href="/sync" class="text-muted hover:text-text">How sync works</a></li>
          <li><a href="/download" class="text-muted hover:text-text">Download and first launch</a></li>
          <li><a href="/privacy" class="text-muted hover:text-text">Privacy policy</a></li>
        </ul>
      </div>
    </aside>
  </section>
</BaseLayout>

<style>
  .answer :global(a) {
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .answer :global(strong) {
    color: var(--color-text);
  }
</style>
