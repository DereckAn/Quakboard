{
  "extends": "astro/tsconfigs/strict",
  // "**/*" only matches TS/JS files. Without "**/*.astro" the bundler looks for
  // the pages' tsconfig up in the repo root, whose extends (.svelte-kit/) doesn't
  // exist in a fresh checkout, and the build fails in CI.
  "include": [".astro/types.d.ts", "**/*", "**/*.astro"],
  "exclude": ["dist"]
}
